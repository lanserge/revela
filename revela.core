CAPI=2:
# Copyright 2026 Serge Rabyking
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
# The VLNV carries no package version. It restated one, and by the
# time anyone looked it said 0.1.0 against a package that had
# reached 0.5.0 -- a second copy of a number pyproject.toml owns.
# Everything this project GENERATES already names itself :0.
name: lanserge:revela:gen:0
description: >
  revela's pipelines as FuseSoC generated cores: a pipeline in, a design
  pack out -- generated Verilog, the register map JSON and the same
  allocation as SystemRDL 2.0, written by np2hw's generator once the
  Verilog is proven bit-exact against the models. Requires revela, which
  brings np2hw (pip install revela).

generators:
  revela:
    command: np2hw-fusesoc
    description: >
      Build a pipeline into a Verilog core with its register maps.
      Parameters: design (the composite's reference, package.module:name,
      required; the calling core's folder is a library root), control
      (emit the AXI4-Lite control plane, default true), clock_mhz,
      verify (default true), sync_memory (default false).
