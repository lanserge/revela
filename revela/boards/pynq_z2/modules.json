{
  "blocks": {
    "revela_isp": {
      "description": "This board's shim around the revela design pack: the header latch and the AXI4-Lite port carried to the boundary.",
      "inputs": [
        {
          "name": "clk"
        },
        {
          "name": "rst"
        },
        {
          "name": "hdr_width",
          "width": 16
        },
        {
          "name": "hdr_height",
          "width": 16
        },
        {
          "name": "hdr_phase",
          "width": 2
        },
        {
          "name": "hdr_bits",
          "width": 5
        },
        {
          "name": "s_axi_aclk"
        },
        {
          "name": "s_axi_aresetn"
        },
        {
          "name": "s_axi",
          "width": 15,
          "bus": "axilite"
        },
        {
          "name": "in",
          "width": "SAMPLE_BITS",
          "stream": [
            "sof",
            "eol",
            "last"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "width": "DATA_BITS",
          "stream": [
            "sof",
            "eol",
            "last"
          ]
        },
        {
          "name": "truncated"
        }
      ],
      "vivado": {
        "module": "revela_isp"
      },
      "sources": [
        "hdl/isp_shim.v"
      ],
      "generated": [
        "revela_isp_core.v"
      ],
      "parameters": {
        "WIDTH": {
          "description": "The width the pack was built for; a wider line is cropped to it."
        },
        "SAMPLE_BITS": {
          "description": "The width of one sample: the depth the receiver aligns every source to."
        },
        "DATA_BITS": {
          "description": "The ISP's traced output word, from its published contract."
        }
      }
    },
    "isp_axis": {
      "description": "The ISP's RGB stream dressed as AXI4-Stream video.",
      "inputs": [
        {
          "name": "clk"
        },
        {
          "name": "rst"
        },
        {
          "name": "in",
          "width": "DATA_BITS",
          "stream": [
            "sof",
            "eol",
            "last"
          ]
        }
      ],
      "outputs": [
        {
          "name": "m_axis",
          "width": 32,
          "bus": "axis",
          "signals": [
            "tkeep",
            "tuser",
            "tlast"
          ]
        }
      ],
      "vivado": {
        "module": "isp_axis"
      },
      "sources": [
        "hdl/isp_axis.v"
      ],
      "parameters": {
        "DATA_BITS": {
          "description": "The ISP's traced output word, from its published contract."
        }
      }
    },
    "tee_shim": {
      "description": "One ISP stream, two switchable consumers, never stalling.",
      "inputs": [
        {
          "name": "clk"
        },
        {
          "name": "rst"
        },
        {
          "name": "in",
          "width": "DATA_BITS",
          "stream": [
            "sof",
            "eol",
            "last"
          ]
        },
        {
          "name": "en_a"
        },
        {
          "name": "en_b"
        }
      ],
      "outputs": [
        {
          "name": "a",
          "width": "DATA_BITS",
          "stream": [
            "sof",
            "eol",
            "last"
          ]
        },
        {
          "name": "b",
          "width": "DATA_BITS",
          "stream": [
            "sof",
            "eol",
            "last"
          ]
        },
        {
          "name": "torn_a"
        },
        {
          "name": "torn_b"
        }
      ],
      "vivado": {
        "module": "tee_shim"
      },
      "sources": [
        "hdl/tee_shim.v"
      ],
      "generated": [
        "isp_tee.v",
        "isp_skid.v",
        "grab_fifo.v"
      ],
      "parameters": {
        "DATA_BITS": {
          "description": "The ISP's traced output word, from its published contract."
        }
      }
    }
  }
}
